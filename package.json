{
  "name": "wastemgnt-booking",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "concurrently \"npm:server\" \"npm:client\"",
    "client": "vite",
    "server": "ts-node-dev --respawn --transpile-only server/index.ts",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "docker-up": "docker compose up --build",
    "test": "npx playwright test --config=automation/playwright.config.ts"
  },
  "postinstall": "npx playwright install chromium",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/express": "^4.17.18",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.0"
  }
}
